library(dplyr)
pg_crime_averages <- pg_crime %>%
group_by(category, month) %>%
summarise(total_incidents = n(), .groups = "drop") %>%
group_by(category) %>%
mutate(average_incidents = mean(total_incidents, na.rm = TRUE))
