library(tidyverse)
install.packages("janitor")
library(janitor)
crimes <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_annual_crime.csv") |> clean_names()
View(crimes)
crimes |> mutate(total_rate = grand_total/population * 10000)
crimes_with_rates <- crimes |> mutate(violent_rate = violent_crime_total/population * 10000, property_rate = property_crime_total/population * 10000)
View(crimes)
View(crimes_with_rates)
crimes |> mutate(total_rate = grand_total/population * 10000)
crimes_with_rates <- crimes |> mutate(violent_rate = violent_crime_total/population * 10000, property_rate = property_crime_total/population * 10000)
crimes_with_rates <- crimes |> mutate(violent_rate = violent_crime_total/population * 10000, property_rate = property_crime_total/population * 10000)
crimes |> mutate(total_rate = grand_total/population * 10000)
library(tidyverse)
library(tidyverse)
set.seed(42)
younguns <- tibble(
age = sample(12:30, 100, replace = TRUE)
)
head(younguns)
sample_50 <-younguns |>
sample_n(50)
sample_10 <-younguns |>
sample_n(10)
sample_50 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_10 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_50 <-younguns |>
sample_n(50)
sample_10 <-younguns |>
sample_n(10)
set.seed(42)
youngings <- tibble(
age = sample(18:80, 1000, replace = TRUE)
)
head(youngings)
sample_100 <-youngings |>
sample_n(100)
sample_100 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
youngings |> summarize(mean = mean(age), median = median(age), sd = sd(age))
#Re-running the code with a smaller sample size.
set.seed(42)
youngings <- tibble(
age = sample(18:80, 100, replace = TRUE)
)
head(youngings)
#re-running code with smaller sample size
sample_50 <-youngings |>
sample_n(50)
sample_100 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
sample_50 |> summarize(mean = mean(age), median = median(age), sd = sd(age))
