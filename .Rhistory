knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
Health <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/montco_inspections.csv")
View(Health)
Health |> compliance_stats <- summarize(mean = mean(compliance_score), sd = sd(compliance_score))
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score))
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score)),
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score))
max(sd), min(sd)
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score))
max(sd) min(sd)
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score))
Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score), max(compliance_score), min(compliance_score))
Compliance_stats <- mean, sd, max, min
Health |> compliance_stats <- summarize(mean = mean(compliance_score), sd = sd(compliance_score), max(compliance_score), min(compliance_score))
compliance_stats <- Health |> summarize(mean = mean(compliance_score), sd = sd(compliance_score), max(compliance_score), min(compliance_score))
View(compliance_stats)
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 5, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Number of M&Ms")
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 1, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Number of M&Ms")
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 10, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Number of M&Ms")
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 5, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Number of M&Ms")
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 10, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Number of M&Ms")
Health |>
ggplot(aes(x= compliance_score)) +
geom_histogram(bins = 10, fill = "blue", color = "black") +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed") +
labs(title = "Montgomery County Health Inspection Scores", x = "Compliance Score", y = "Establishment ID")
Participation <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_hs_participation.csv")
View(Participation)
Participation |> mutate(girls_pct = boys+girls/girls * 100)
Participation |> mutate(girls_pct = boys+girls/girls * .1)
Participation |> mutate(girls_pct = boys+girls/100)
Participation |> mutate(girls_pct = boys+girls/girls)
Participation |> mutate(total = boys+girls, girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls,
girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls)
Participation |> (girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls),
Participation |> mutate(total = boys+girls) +
Participation |> (girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls) +
(girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls) +
mutate(girls_pct = boys-girls/girl *100)
Participation |> mutate(total = boys+girls) +
mutate(girls_pct = boys-girls/girls *100)
Participation |> mutate(total = boys+girls)
Participation |> mutate(girls_pct = boys-girls/girls*100)
Participation |> mutate(girls_pct = (boys-girls)/girls*100)
Participation |> mutate(total = boys+girls) |>
mutate(girls_pct = (boys-girls)/girls*100)
Participation |> summarize(correlation = cor(boys, girls, method="pearson"))
Participation |>
ggplot() +
geom_point(aes(x=boys, y=girls)) +
geom_smooth(aes(x=boys, y=girls), method="lm") +
labs(title="Correlation between the boy and girl participations", x= "Boys", y = "Girls")
Car_thefts <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_car_thefts.csv")
View(Car_thefts)
Car_thefts |> mutate(rate = ("2023"/population)*100)
Car_thefts |> mutate(rate = (`2023`/population)*100)
Car_thefts |> mutate(rate_23 = (`2023`/population)*100) |>
mutate(rate_22 = (`2022`/population)*100)
Car_thefts |> mutate(rate_22 = (`2022`/population)*100) |>
mutate(rate_23 = (`2023`/population)*100)
Car_thefts |> summarize(median22 =median(`2022`), median23 = median(`2023`), total22 = total(`2022`), total23 = total(`2023`))
Car_thefts |> summarize(median22 = median(`2022`), median23 = median(`2023`), total22 = total(`2022`), total23 = total(`2023`))
Car_thefts |> summarize(median = median(`2023`)
Car_thefts |> summarize(median = median(`2023`))
Car_thefts |> summarize(median = median(`2023`), total = sum(`2023`))
